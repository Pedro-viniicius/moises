[Unit]
Description=Coletor do painel moises (sessões do Claude Code)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Documentos/saas/moises
ExecStart=/usr/bin/env node collector/index.js
Environment=PATH=%h/.nvm/versions/node/v22.23.0/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=10
Nice=10
# As sessões comandadas pelo painel (processos `claude`) rodam no mesmo grupo do serviço: por isso 4G.
# Reiniciar ou parar o serviço encerra as sessões comandadas (elas ficam retomáveis pelo painel).
MemoryHigh=4G
NoNewPrivileges=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes

[Install]
WantedBy=default.target
